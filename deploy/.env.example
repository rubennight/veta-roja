# Copia este archivo a deploy/.env y complétalo. deploy/.env NUNCA se versiona.

# Contraseña de la base de datos (elige una larga y única).
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-larga

# Dirección pública del sitio. Va impresa en cada QR: debe ser definitiva.
PUBLIC_BASE_URL=https://vetaroja.mx

# Dominio que atiende Caddy (con HTTPS automático). Para pruebas locales sin HTTPS usa ":80".
SITE_ADDRESS=vetaroja.mx
